# Set demo for the browser-only portfolio mode, or local for SQLite. Vercel defaults to demo when unset.
# NEXORA_MODE=demo

# Optional server-side structured analysis. The app works with Built-in analysis/local without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional exact browser origin for mutating API requests. Leave empty for local 3002 defaults.
APP_ORIGIN=
